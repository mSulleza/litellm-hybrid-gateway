<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.msulleza.litellm</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/msulleza/litellm/run.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/msulleza/litellm</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/Users/msulleza/litellm/logs/litellm.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/msulleza/litellm/logs/litellm.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
