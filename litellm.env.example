# Copy this file to `litellm.env` and fill in real values. litellm.env is
# gitignored — never commit real keys.
#
#   cp litellm.env.example litellm.env && $EDITOR litellm.env

# Local proxy master key — any string. Clients authenticate with this.
# Generate one, e.g.:  echo "sk-local-$(openssl rand -hex 24)"
export LITELLM_MASTER_KEY="sk-local-CHANGEME"

# DeepSeek V4 Pro (heavy code executor). Key from platform.deepseek.com.
export DEEPSEEK_API_KEY="sk-CHANGEME"

# Z.ai / BigModel GLM-5.2 (main planner). Key from z.ai / open.bigmodel.cn.
# Without this, the launcher degrades the main loop to DeepSeek.
export ZAI_API_KEY="CHANGEME"

# OPTIONAL: Anthropic frontier escalation (/model opus → Sonnet 5).
# Without it, claude-smart 401s but the proxy stays up. From console.anthropic.com.
# export ANTHROPIC_API_KEY="sk-ant-CHANGEME"
